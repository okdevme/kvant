{
  "compilerOptions": {
    "target": "es2022",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "rootDirs": [".", "./.react-router/types"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["app", "specs", ".react-router/types/**/*"]
}
