{
  "name": "kvantjs",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "description": "Universal, type-safe state manager for key-value interfaces",
  "author": "okdevme",
  "license": "MIT",
  "homepage": "https://kvantjs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okdevme/kvant.git"
  },
  "bugs": {
    "url": "https://github.com/okdevme/kvant/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "state-management",
    "url-state",
    "search-params",
    "query-params",
    "query-string",
    "localstorage",
    "sessionstorage",
    "cookies",
    "key-value",
    "type-safe",
    "typescript",
    "schema",
    "validation",
    "nuqs",
    "zod",
    "react",
    "react-hooks",
    "nextjs",
    "react-router",
    "vue",
    "vue-composables",
    "nuxt",
    "vue-router"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./next": "./dist/next.mjs",
    "./next/pages": "./dist/next/pages.mjs",
    "./nuxt": "./dist/nuxt.mjs",
    "./react": "./dist/react.mjs",
    "./react-router": "./dist/react-router.mjs",
    "./schema": "./dist/schema.mjs",
    "./vue": "./dist/vue.mjs",
    "./vue-router": "./dist/vue-router.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:e2e": "turbo run test --filter=\"./e2e/*\"",
    "prepare": "simple-git-hooks",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "docs:build:lowmem": "pnpm --filter docs build:lowmem",
    "docs:start": "pnpm --filter docs start"
  },
  "peerDependencies": {
    "next": "^14.2.x || ^15 || ^16",
    "nuxt": "^3 || ^4",
    "react": "^18 || ^19",
    "react-router": "^7 || ^8",
    "vue": "^3",
    "vue-router": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "catalog:",
    "@types/react": "catalog:",
    "@vue/server-renderer": "catalog:",
    "arktype": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "next": "catalog:",
    "nuxt": "catalog:",
    "publint": "catalog:",
    "qs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
