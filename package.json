{
  "name": "kvant",
  "type": "module",
  "version": "0.1.0",
  "description": "A starter for creating a TypeScript package.",
  "author": "okdevme",
  "license": "MIT",
  "homepage": "https://github.com/author/library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./next/app": "./dist/next/app.mjs",
    "./react": "./dist/react.mjs",
    "./react/storage": "./dist/react/storage.mjs",
    "./schema": "./dist/schema.mjs",
    "./storage": "./dist/storage.mjs",
    "./vue": "./dist/vue.mjs",
    "./vue/storage": "./dist/vue/storage.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "next": ">=14.2.0",
    "react": ">=18.0.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm build && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
