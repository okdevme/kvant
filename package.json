{
  "name": "kvant",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "description": "A starter for creating a TypeScript package.",
  "author": "okdevme",
  "license": "MIT",
  "homepage": "https://github.com/author/library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./next": "./dist/next.mjs",
    "./next/pages": "./dist/next/pages.mjs",
    "./nuxt": "./dist/nuxt.mjs",
    "./react": "./dist/react.mjs",
    "./react-router": "./dist/react-router.mjs",
    "./schema": "./dist/schema.mjs",
    "./vue": "./dist/vue.mjs",
    "./vue-router": "./dist/vue-router.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:e2e": "turbo run test --filter=\"./e2e/*\"",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "next": "^14.2.x || ^15 || ^16",
    "nuxt": "^3 || ^4",
    "react": "^18 || ^19",
    "react-router": "^7 || ^8",
    "vue": "^3",
    "vue-router": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/node": "catalog:",
    "@types/qs": "catalog:",
    "@types/react": "catalog:",
    "arktype": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "next": "catalog:",
    "nuxt": "catalog:",
    "publint": "catalog:",
    "qs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
