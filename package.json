{
  "name": "kvant",
  "type": "module",
  "version": "0.1.0",
  "description": "A starter for creating a TypeScript package.",
  "author": "okdevme",
  "license": "MIT",
  "homepage": "https://github.com/author/library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./next/app": "./dist/next/app.mjs",
    "./react": "./dist/react/index.mjs",
    "./schema": "./dist/schema/index.mjs",
    "./storage": "./dist/storage.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "next": ">=14.2.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.1.0",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm build && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
